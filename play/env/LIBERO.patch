+                    (range_phi[1] - range_phi[0]) / 6.0,
+                ),
+                range_phi[0],
+                range_phi[1],
+            )
+        else:
+            raise NotImplementedError
+
+        # Converting spherical to pos and quat
+        r_theta_phi = (sample_r, sample_theta, sample_phi)
