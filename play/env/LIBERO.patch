+                0
+            ]
+            sample_theta = (
+                range_theta[1] - range_theta[0]
+            ) * np.random.random_sample() + range_theta[0]
+            sample_phi = (
+                range_phi[1] - range_phi[0]
+            ) * np.random.random_sample() + range_phi[0]
+        elif jitter_mode == "normal":
